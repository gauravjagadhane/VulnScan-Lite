# Generate a long random value for production, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-production-secret
ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://vulnscan:replace-with-a-local-development-password@localhost:5432/vulnscan
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REQUEST_TIMEOUT_SECONDS=12
MAX_RESPONSE_BYTES=1000000
MAX_REDIRECTS=3
MAX_CONCURRENT_SCANS=3
SCANS_PER_HOUR=10
VITE_API_URL=http://localhost:8000
